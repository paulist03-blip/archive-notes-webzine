{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/archive",
      "destination": "/archive.html"
    },
    {
      "source": "/book-archive",
      "destination": "/book-archive.html"
    },
    {
      "source": "/book-review-board",
      "destination": "/book-review-board.html"
    },
    {
      "source": "/daily-ai-work",
      "destination": "/daily-ai-work.html"
    },
    {
      "source": "/forum",
      "destination": "/forum.html"
    },
    {
      "source": "/mobile",
      "destination": "/ai-work-mobile.html"
    },
    {
      "source": "/posts/:slug",
      "destination": "/posts/:slug.html"
    }
  ]
}
